# Python cache files
*.pyc
__pycache__/

# Local copies of repo-root templates — copy from the .example versions
# and fill in your own values. Templates stay tracked, locals do not.
/.env
/config.py

# Deprecated tools
depr/

# Example sandbox directories
examples/advanced/**/sandbox_notebook/
examples/advanced/**/demo_sandbox/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# Local Claude Code settings (per-clone, not part of toolkit config)
.claude/
eval/reference_cache/

# eval / demo scratch sandboxes (not artifacts)
examples/eval_sandbox/
examples/lagrangian_extraction_sandbox/

# INSPIRE query cache (local, regenerated on demand)
.inspire_cache.json

# Local-only bundle for sending a paper+model pair out for scientist review
# (contains a copyrighted arXiv PDF — not for the public repo).
examples/verification_package/

# Fetched third-party paper content pulled during demo runs — physicist-
# published sources we do not redistribute (regenerated by run_demo.sh).
examples/demo_codex_research/source/
examples/demo_codex_research/text/
examples/demo_codex_research/pdfs/

# Stray tool byproducts written to the repo root when a tool runs with
# base_directory=. (audit ledgers, ad-hoc generated models). Not artifacts.
/model/
/audit.json
/audit.md
/*_audit.json
/*_audit.md

# Validation-benchmark UFO scratch (regenerated by validation_benchmark.py;
# point VBENCH_OUT outside the repo). The .json/.md report IS tracked.
/eval/benchmark_runs/vbench*/

# DB benchmark: third-party papers (re-fetched by db_run_prep.py) and bulky
# raw event streams (codex_out.md keeps the extraction evidence).
eval/benchmark_runs/*/pdfs/
eval/benchmark_runs/*/text/
eval/benchmark_runs/*/codex_events.jsonl
